---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import fallbackCover from '../../images/103.jpg';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const albums = await getCollection('photoAlbums', ({ data }) => !data.draft);
  albums.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return paginate(albums, { pageSize: 9 });
}

const { page } = Astro.props;
const albumCount = page.total;
---

<BaseLayout title='Photos' description='Photo albums'>
  <div class='container animate'>
    <section class='photos-page' aria-labelledby='photos-title'>
      <header class='photos-page__header'>
        <div>
          <p class='photos-page__eyebrow'>Photo journals</p>
          <h1 id='photos-title' class='page-title'>照片相册</h1>
        </div>
        <p class='photos-page__intro'>把路上的光、风景与片刻，收进一册册影像里。</p>
      </header>

      <div class='albums-grid'>
        {page.data.map((album) => {
          const cover = album.data.cover || album.data.images?.[0]?.src || fallbackCover.src;
          const photoCount = album.data.images?.length || 0;

          return (
            <article class='album-card'>
              <a
                href={`/photos/${album.id}/`}
                class='album-card__link'
                aria-label={`打开相册：${album.data.title}`}
              >
                <div class='album-card__stage'>
                  <div class='album-card__cover'>
                    <img
                      src={cover}
                      data-fallback={fallbackCover.src}
                      alt={`${album.data.title}相册封面`}
                      loading='lazy'
                      decoding='async'
                    />
                    <span class='album-card__count'>{photoCount} 张照片</span>
                  </div>
                </div>

                <div class='album-card__info'>
                  <h2 class='album-card__title'>{album.data.title}</h2>
                  <p class='album-card__meta'>
                    <span>{album.data.location}</span>
                    <span aria-hidden='true'>/</span>
                    <time datetime={album.data.date}>{album.data.date}</time>
                  </p>
                  <p class='album-card__desc'>{album.data.description}</p>
                </div>
              </a>
            </article>
          );
        })}
      </div>

      <p class='photos-page__total'>{String(albumCount).padStart(2, '0')} albums</p>
      <Pagination currentPage={page.currentPage} totalPages={page.lastPage} baseUrl='/photos/' />
    </section>
  </div>
</BaseLayout>

<script>
  function installCoverFallbacks() {
    document.querySelectorAll<HTMLImageElement>('.album-card__cover img').forEach((image) => {
      if (image.dataset.fallbackReady === 'true') return;

      image.dataset.fallbackReady = 'true';
      image.addEventListener('error', () => {
        const fallback = image.dataset.fallback;
        if (fallback && image.src !== new URL(fallback, window.location.href).href) {
          image.src = fallback;
        }
      });
    });
  }

  installCoverFallbacks();
  document.addEventListener('astro:page-load', installCoverFallbacks);
</script>
